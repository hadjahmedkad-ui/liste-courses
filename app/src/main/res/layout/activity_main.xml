<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛒 Liste Courses"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#222222"
            android:padding="12dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MA LISTE"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"/>
        <EditText
            android:id="@+id/wanted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Produit à acheter"
            android:inputType="text"
            android:padding="12dp"/>
        <Button
            android:id="@+id/addwanted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AJOUTER À MA LISTE"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:id="@+id/wantedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#CCCCCC"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MES ACHATS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:paddingBottom="8dp"/>
        <Button
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 SCANNER LE PRODUIT"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom du produit"
            android:inputType="text"/>
        <EditText
            android:id="@+id/quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantité (unités)"
            android:inputType="numberDecimal"/>
        <EditText
            android:id="@+id/weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Poids (kg)"
            android:inputType="numberDecimal"/>
        <EditText
            android:id="@+id/price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prix unitaire ou au kilo (€)"
            android:inputType="numberDecimal"/>
        <Button
            android:id="@+id/addpurchase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AJOUTER UN ACHAT"/>
        <LinearLayout
            android:id="@+id/purchases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
        <TextView
            android:id="@+id/subtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sous-total : 0,00 €"
            android:textSize="20sp"
            android:padding="12dp"/>
        <TextView
            android:id="@+id/total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL : 0,00 €"
            android:textStyle="bold"
            android:textSize="24sp"
            android:padding="12dp"/>
        <Button
            android:id="@+id/reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RÉINITIALISER LES ACHATS"/>
    </LinearLayout>
</ScrollView>
