<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream">
<LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
 <TextView android:text="🛒 Liste Courses" android:textStyle="bold" android:textSize="28sp" android:textColor="@color/green_dark" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <TextView android:text="Ma liste de courses" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/wanted" android:hint="Ex. tomates, lait, café…" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/addWanted" android:text="Ajouter à ma liste" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:id="@+id/wantedList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <View android:layout_marginTop="14dp" android:background="#DDDDDD" android:layout_width="match_parent" android:layout_height="1dp"/>
 <TextView android:text="Mes achats" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <Button android:id="@+id/scan" android:text="📷 Scanner l’étiquette du produit" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/product" android:hint="Produit" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/price" android:hint="Prix unitaire ou prix au kilo (€)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <RadioGroup android:id="@+id/mode" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><RadioButton android:id="@+id/unit" android:checked="true" android:text="À l’unité" android:layout_width="wrap_content" android:layout_height="wrap_content"/><RadioButton android:id="@+id/weight" android:text="Au poids" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></RadioGroup>
 <EditText android:id="@+id/amount" android:hint="Quantité (ex. 2)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/addPurchase" android:text="Confirmer et ajouter" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:id="@+id/purchases" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/subtotal" android:text="Sous-total : 0,00 €" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/total" android:text="Total : 0,00 €" android:textStyle="bold" android:textSize="24sp" android:textColor="@color/green_dark" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <Button android:id="@+id/reset" android:text="Réinitialiser TOTAL + SOUS-TOTAL" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
